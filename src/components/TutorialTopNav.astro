---
import { SITE } from "../lib/site";
import { pathFromRoot } from "../lib/paths";

const path = Astro.url.pathname;
const isHome = path === "/" || path === "";
const isTutorials =
  path === "/python" ||
  path === "/python/" ||
  (path.startsWith("/python/") &&
    !path.startsWith("/python/reference") &&
    !path.startsWith("/python/quiz"));
const isQuiz = path.startsWith("/python/quiz");
const isReference = path.startsWith("/python/reference");
const isAiTerms = path === "/ai-terminology" || path.startsWith("/ai-terminology/");
const isFastapi = path === "/fastapi" || path.startsWith("/fastapi/");

const mainNav = [
  { href: pathFromRoot("python/"), label: "Python", active: isTutorials },
  { href: pathFromRoot("fastapi/"), label: "FastAPI", active: isFastapi },
  { href: pathFromRoot("ai-terminology/"), label: "AI Terms", active: isAiTerms },
  { href: pathFromRoot("python/reference/"), label: "References", active: isReference },
  { href: pathFromRoot("python/quiz/"), label: "Quizzes", active: isQuiz },
];
---

<header class="site-header sticky top-0 z-50 border-b border-border bg-nav-bg">
  <div class="mx-auto flex h-14 max-w-[1500px] items-center gap-2 px-3 sm:gap-3 sm:px-4">
    {
      !isHome && (isTutorials || isQuiz || isReference || isAiTerms || isFastapi) && (
        <button
          type="button"
          id="sidebar-toggle"
          class="sidebar-toggle flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-border text-text-secondary lg:hidden"
          aria-label="Open course menu"
          aria-expanded="false"
          aria-controls="tutorial-sidebar"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>
      )
    }

    <a
      href={pathFromRoot("")}
      class="site-brand flex min-w-0 shrink items-center gap-2 no-underline sm:gap-2.5"
      aria-current={isHome ? "page" : undefined}
    >
      <span
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand font-mono text-xs font-bold text-white sm:h-9 sm:w-9 sm:text-sm"
        >Py</span
      >
      <span class="hidden truncate text-base font-bold text-text min-[420px]:inline sm:text-lg"
        >{SITE.name}</span
      >
    </a>

    <nav class="main-nav-desktop hidden min-w-0 flex-1 items-center justify-center lg:flex" aria-label="Main">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={["topnav-link text-sm", item.active && "is-active"]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      <div id="google-signup-wrap">
        <button
          type="button"
          id="google-signup-btn"
          data-google-signin
          class="btn-secondary gap-2 px-2 py-2 text-xs sm:px-3 sm:text-sm"
          aria-label="Sign up with Google"
        >
          <svg class="h-4 w-4 shrink-0 sm:h-[18px] sm:w-[18px]" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#4285F4"
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
            ></path>
            <path
              fill="#34A853"
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
            ></path>
            <path
              fill="#FBBC05"
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
            ></path>
            <path
              fill="#EA4335"
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
            ></path>
          </svg>
          <span class="hidden sm:inline">Sign up with Google</span>
        </button>
      </div>
      <div id="auth-profile-wrap" class="hidden items-center gap-2">
        <img
          id="auth-profile-avatar"
          class="auth-profile-avatar hidden h-8 w-8 rounded-full border border-border object-cover sm:h-9 sm:w-9"
          alt=""
          width="36"
          height="36"
        />
        <span
          id="auth-profile-initials"
          class="auth-profile-initials hidden h-8 w-8 items-center justify-center rounded-full border border-border bg-brand font-mono text-xs font-bold text-white sm:h-9 sm:w-9 sm:text-sm"
          aria-hidden="true"
        ></span>
        <span
          id="auth-profile-name"
          class="hidden max-w-[5rem] truncate text-xs font-medium text-text-secondary min-[420px]:inline sm:max-w-[10rem] sm:text-sm"
        ></span>
      </div>
    </div>
  </div>

  <nav class="main-nav-mobile lg:hidden" aria-label="Main">
    <div class="main-nav-mobile-scroll">
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={["topnav-link main-nav-mobile-link", item.active && "is-active"]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
