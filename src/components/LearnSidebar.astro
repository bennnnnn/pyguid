---
import type { LessonGroup } from "../lib/lessons";
import {
  getAllLessonsInGroup,
  getOutlineGroups,
  groupContainsLesson,
  lessonUrl,
  topicAnchorId,
} from "../lib/lessons";

interface Props {
  groups?: LessonGroup[];
  currentLessonId?: string;
}

const { currentLessonId } = Astro.props;
const groups = await getOutlineGroups();

function chapterIsOpen(group: LessonGroup): boolean {
  return groupContainsLesson(group, currentLessonId ?? "");
}
---

<aside
  id="tutorial-sidebar"
  class="course-sidebar w-full shrink-0 border-r border-border bg-sidebar-bg lg:sticky lg:top-14 lg:block lg:w-[272px] lg:self-start lg:max-h-[calc(100vh-3.5rem)] lg:overflow-y-auto"
>
  <div class="border-b border-border px-4 py-3">
    <p class="m-0 text-xs font-semibold uppercase tracking-wider text-text-muted">
      Python tutorials
    </p>
  </div>

  <nav class="py-2" aria-label="Tutorial lessons">
    <ul class="m-0 list-none p-0">
      {
        groups.map((group) => {
          const isOpen = chapterIsOpen(group);
          const groupId = topicAnchorId(group.chapterTitle);
          const lessons = getAllLessonsInGroup(group);
          return (
            <li class:list={["menu-group", "chapter-group", isOpen && "is-open"]}>
              <button
                type="button"
                class="menu-trigger flex w-full items-center justify-between gap-2 py-2 pl-4 pr-4 text-left text-sm font-semibold"
                aria-expanded={isOpen}
                aria-controls={`${groupId}-content`}
              >
                <span class="truncate">{group.chapterTitle}</span>
                <svg
                  class="menu-icon h-4 w-4 shrink-0 text-text-muted"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </button>
              <ul id={`${groupId}-content`} class="submenu m-0 list-none p-0">
                {lessons.map((lesson) => (
                  <li>
                    <a
                      href={lessonUrl(lesson.id)}
                      class:list={[
                        "lesson-link block py-2 pl-8 pr-4 text-sm",
                        currentLessonId === lesson.id && "is-active",
                      ]}
                    >
                      {lesson.data.navTitle ?? lesson.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>
