---
import { highlightPythonLine } from "../lib/highlight-python";

interface Props {
  code: string;
  filename?: string;
}

const { code, filename = "example.py" } = Astro.props;
const lines = code.trim().split("\n");
---

<div class="python-example not-prose my-8 overflow-hidden rounded-xl border border-ink-200 bg-white shadow-sm">
  <div class="flex flex-wrap items-center gap-2 border-b border-ink-100 bg-ink-50 px-4 py-2.5">
    <div class="mr-2 flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-red-400/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-amber-400/80"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/80"></span>
    </div>
    <span class="font-mono text-xs text-ink-600">{filename}</span>
    <span class="ml-auto flex gap-2">
      <button
        type="button"
        class="py-copy rounded-md border border-ink-200 bg-white px-2.5 py-1 text-xs font-medium text-ink-700 hover:bg-ink-50"
        data-code={code}
      >
        Copy
      </button>
      <button
        type="button"
        class="py-run rounded-md bg-brand-600 px-3 py-1 text-xs font-semibold text-white hover:bg-brand-700"
        data-code={code}
      >
        ▶ Run
      </button>
    </span>
  </div>
  <div class="bg-[#1e2228] px-4 py-4 font-mono text-[13px] leading-7 text-[#abb2bf]">
    {
      lines.map((line, i) => (
        <div class="code-line" data-n={i + 1}>
          <span set:html={highlightPythonLine(line)} />
        </div>
      ))
    }
  </div>
  <div class="border-t border-ink-100 bg-ink-50 px-4 py-3">
    <p class="mb-1 text-[10px] font-semibold uppercase tracking-widest text-ink-400">Output</p>
    <pre class="py-output min-h-[2.5rem] font-mono text-sm text-ink-800">Click Run…</pre>
  </div>
</div>

<script>
  import { runPython } from "../scripts/run-python";

  document.querySelectorAll(".py-copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const code = (btn as HTMLButtonElement).dataset.code ?? "";
      await navigator.clipboard.writeText(code);
      const el = btn as HTMLButtonElement;
      const prev = el.textContent;
      el.textContent = "Copied!";
      setTimeout(() => {
        el.textContent = prev;
      }, 1200);
    });
  });

  document.querySelectorAll(".py-run").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const root = btn.closest(".python-example");
      const output = root?.querySelector(".py-output") as HTMLElement | null;
      const code = (btn as HTMLButtonElement).dataset.code ?? "";
      if (!output) return;

      const runBtn = btn as HTMLButtonElement;
      runBtn.disabled = true;
      runBtn.textContent = "Running…";
      output.textContent = "";
      output.classList.remove("text-red-600");

      try {
        const result = await runPython(code);
        output.textContent = result || "(no output)";
        if (result.startsWith("Error:")) output.classList.add("text-red-600");
      } catch (e) {
        output.textContent = `Error: ${e instanceof Error ? e.message : String(e)}`;
        output.classList.add("text-red-600");
      } finally {
        runBtn.disabled = false;
        runBtn.textContent = "▶ Run";
      }
    });
  });
</script>
