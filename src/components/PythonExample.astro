---
import { highlightPython } from "../lib/highlight-code";

interface Props {
  code: string;
  filename?: string;
}

const { code, filename = "example.py" } = Astro.props;
const highlightedCode = await highlightPython(code);
---

<div
  class="python-example not-prose my-8 overflow-hidden rounded-xl border border-border bg-surface shadow-sm"
>
  <textarea class="py-source" hidden readonly aria-hidden="true">{code.trim()}</textarea>
  <div
    class="flex flex-wrap items-center justify-between gap-3 border-b border-border bg-surface-alt px-4 py-3"
  >
    <span class="font-mono text-xs font-medium text-text-muted">{filename}</span>
    <div class="flex gap-2">
      <button
        type="button"
        class="py-copy rounded-lg border border-border bg-surface px-3 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:bg-surface-alt"
      >
        Copy
      </button>
      <button
        type="button"
        class="py-run rounded-lg bg-brand px-4 py-1.5 text-xs font-semibold text-white transition-colors hover:bg-brand-hover"
      >
        Run code
      </button>
    </div>
  </div>
  <div class="code-panel overflow-x-auto px-4 py-4" set:html={highlightedCode} />
  <div class="py-output-section border-t border-border px-4 py-3">
    <p class="mb-1.5 text-xs font-medium text-text-muted">Output</p>
    <pre
      class="py-output min-h-[2.5rem] overflow-x-auto font-mono text-sm leading-relaxed"
      >Run the code to see output here.</pre
    >
  </div>
</div>
