---
import type { ChapterEntry } from "../lib/chapters";
import { chapterId, chapterUrl } from "../lib/chapters";

interface Props {
  chapter: ChapterEntry;
  isCurrent?: boolean;
}

const { chapter, isCurrent = false } = Astro.props;
const { order, title, description, subtopics } = chapter.data;
---

<a
  href={chapterUrl(chapterId(chapter))}
  class:list={[
    "group block rounded-xl border p-6 transition hover:border-brand-500/40 hover:shadow-md",
    isCurrent
      ? "border-brand-200 bg-brand-50/60 ring-1 ring-brand-500/20"
      : "border-ink-200 bg-white",
  ]}
>
  <span
    class:list={[
      "text-xs font-semibold uppercase tracking-wide",
      isCurrent ? "text-brand-600" : "text-ink-400",
    ]}
  >
    Chapter {order}{isCurrent ? " · You are here" : ""}
  </span>
  <h3
    class:list={[
      "mt-1 text-lg font-semibold text-ink-900 group-hover:text-brand-700",
    ]}
  >
    {title}
  </h3>
  <p class="mt-2 text-sm text-ink-600">{description}</p>
  <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-ink-400">Sub-topics</p>
  <ul class="mt-2 space-y-1.5 rounded-lg bg-ink-50 p-3 text-sm text-ink-700">
    {
      subtopics.map((st) => (
        <li class="flex gap-2">
          <span class="text-brand-500">·</span>
          <span>{st.title}</span>
        </li>
      ))
    }
  </ul>
</a>
