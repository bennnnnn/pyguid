---
import { SITE } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-ink-200 bg-white py-10">
  <div
    class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-sm text-ink-600 sm:flex-row"
  >
    <p>© {year} {SITE.name}. Free Python tutorials.</p>
    <div class="flex gap-6">
      <a href="/about/" class="hover:text-brand-700">About</a>
      <a href="/learn/" class="hover:text-brand-700">Learn</a>
      <a href="/cheatsheet/" class="hover:text-brand-700">Cheatsheet</a>
    </div>
  </div>
</footer>
