---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = "Frequently asked questions" } = Astro.props;
---

{
  items.length > 0 && (
    <section class="seo-faq not-prose mt-10" aria-labelledby="lesson-faq-heading">
      <h2 id="lesson-faq-heading">{title}</h2>
      <dl class="mt-4 space-y-5">
        {items.map((item) => (
          <div class="rounded-lg border border-border bg-surface-muted/30 px-4 py-3">
            <dt class="font-semibold text-text">{item.question}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-text-secondary">
              {item.answer}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
