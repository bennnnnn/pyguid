---
import type { ChapterQuiz } from "../../lib/quizzes";

interface Props {
  exam: ChapterQuiz;
  quizSlug?: string;
  backHref?: string;
  backLabel?: string;
  kindLabel?: string;
}

const {
  exam,
  quizSlug,
  backHref = "/python/quiz/",
  backLabel = "All quizzes",
  kindLabel = "Chapter quiz",
} = Astro.props;
const quizPayload = {
  chapter: exam.chapter,
  chapterTitle: exam.chapterTitle,
  title: exam.title,
  passPercent: exam.passPercent,
  questions: exam.questions,
  quizSlug,
};
---

<div id="chapter-quiz-root" class="chapter-quiz">
  <script
    type="application/json"
    id="chapter-quiz-data"
    set:html={JSON.stringify(quizPayload)}
  />
  <header class="quiz-exam-header">
    <p class="mb-1 text-sm font-semibold uppercase tracking-wide text-text-muted">
      {kindLabel}
    </p>
    <h1>{exam.title}</h1>
    <p class="mt-2 text-text-secondary">{exam.description}</p>
    <div class="quiz-exam-meta mt-4">
      <span>Chapter {exam.chapter}</span>
      <span>{exam.questions.length} questions</span>
      <span>Pass: {exam.passPercent}%+</span>
    </div>
  </header>

  <div data-exam-form>
    <div class="quiz-progress">
      <div class="quiz-progress-track">
        <div class="quiz-progress-fill" data-progress-fill style="width: 0%"></div>
      </div>
      <p class="quiz-progress-label">
        <span>Answer every question, then submit</span>
        <span data-progress-answered>0 of {exam.questions.length} answered</span>
      </p>
    </div>

    {
      exam.questions.map((q, i) => (
        <article class="quiz-question-card" data-question-card data-q-index={i}>
          <span class="quiz-q-number">Q{i + 1}</span>
          <p class="quiz-q-prompt">{q.prompt}</p>
          {q.type === "choice" ? (
            <div class="quiz-options">
              {q.options.map((opt, oi) => (
                <label class="quiz-option">
                  <input
                    type="radio"
                    name={`q-${q.id}`}
                    value={oi}
                    aria-label={`Option ${oi + 1}`}
                  />
                  <span class="quiz-option-label">{opt}</span>
                </label>
              ))}
            </div>
          ) : (
            <div class="quiz-tf-options quiz-options">
              <label class="quiz-option">
                <input type="radio" name={`q-${q.id}`} value="true" />
                <span class="quiz-option-label">True</span>
              </label>
              <label class="quiz-option">
                <input type="radio" name={`q-${q.id}`} value="false" />
                <span class="quiz-option-label">False</span>
              </label>
            </div>
          )}
        </article>
      ))
    }

    <div class="quiz-submit-bar">
      <p class="text-sm text-text-muted">
        Unanswered questions are highlighted when you submit.
      </p>
      <button type="button" class="btn-primary" data-submit-exam>Submit quiz</button>
    </div>
  </div>

  <section class="quiz-results quiz-hidden" data-exam-results aria-live="polite">
    <div class="quiz-score-ring" data-score-ring style="--score-pct: 0">
      <div class="quiz-score-ring-inner">
        <span class="quiz-score-value" data-score-value>0%</span>
        <span class="quiz-score-label">Score</span>
      </div>
    </div>
    <p class="quiz-results-verdict quiz-results-fail" data-results-verdict></p>
    <p class="quiz-results-summary" data-results-summary></p>
    <div class="quiz-results-actions flex flex-wrap justify-center gap-3">
      <button type="button" class="btn-primary" data-retry-exam>Try again</button>
      <a href={backHref} class="btn-secondary no-underline">{backLabel}</a>
      <a href={`/python/`} class="btn-secondary no-underline"> Back to lessons </a>
    </div>
    <h2 class="quiz-review-heading">Review your answers</h2>
    <div class="quiz-review-list" data-review-list></div>
  </section>
</div>

<script>
  import { initChapterQuiz } from "../../scripts/quiz-ui";
  initChapterQuiz();
</script>
