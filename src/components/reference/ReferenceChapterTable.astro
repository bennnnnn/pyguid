---
import {
  referenceEntrySlug,
  referenceSheetAnchorUrl,
  type ReferenceSheet,
} from "../../lib/reference-sheets";

interface Props {
  sheet: ReferenceSheet;
}

const { sheet } = Astro.props;
---

<div class="ref-table-wrap">
  <table class="ref-table">
    <thead>
      <tr>
        <th scope="col">Syntax</th>
        <th scope="col">What it does</th>
        <th scope="col">Notes</th>
      </tr>
    </thead>
    <tbody>
      {
        sheet.entries.map((entry, index) => {
          const slug = referenceEntrySlug(sheet.id, index);
          const href = referenceSheetAnchorUrl(sheet.id, slug);
          return (
          <tr>
            <th scope="row" class="ref-syntax">
              <a href={href} class="ref-syntax-link">
                <code>{entry.syntax}</code>
              </a>
            </th>
            <td>{entry.summary}</td>
            <td class="ref-notes">{entry.title}</td>
          </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
