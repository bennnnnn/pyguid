---
import type { ReferenceEntryPage } from "../../lib/reference-sheets";
import { getAdjacentReferencePages } from "../../lib/reference-sheets";
import { getReferenceEntryCode } from "../../lib/reference-entry-code";
import HighlightedCode from "../HighlightedCode.astro";
import PythonExample from "../PythonExample.astro";
import ReferencePager from "./ReferencePager.astro";

interface Props {
  page: ReferenceEntryPage;
}

const { page } = Astro.props;
const { entry } = page;
const { code, runnable, filename } = getReferenceEntryCode(page);
const { prev, next } = getAdjacentReferencePages(page);
const exampleLine = entry.example?.trim();
---

<article class="ref-entry-page lesson-prose max-w-3xl">
  <ReferencePager prev={prev} next={next} placement="top" />

  <h1 class="ref-entry-title !mt-0 !mb-3">
    <code>{entry.syntax}</code>
  </h1>

  <p class="ref-entry-lead !mt-0">{entry.summary}</p>

  {
    exampleLine && (
      <p class="ref-entry-example !mt-0">
        <span class="font-semibold text-text">Example:</span>{" "}
        <code>{exampleLine}</code>
      </p>
    )
  }

  <div class="ref-entry-code-block mt-6">
    {
      runnable ? (
        <PythonExample code={code} filename={filename} />
      ) : (
        <HighlightedCode code={code} variant="light" aria-label="Example" />
      )
    }
  </div>

  <ReferencePager prev={prev} next={next} placement="bottom" />
</article>
