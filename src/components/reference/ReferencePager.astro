---
import { referenceEntryUrl } from "../../lib/reference-sheets";
import PagerNav from "../PagerNav.astro";

interface NavItem {
  slug: string;
  name: string;
}

interface Props {
  sheetId: string;
  prev?: NavItem;
  next?: NavItem;
  placement?: "top" | "bottom";
}

const { sheetId, prev, next, placement = "bottom" } = Astro.props;
---

<PagerNav
  prev={prev ? { href: referenceEntryUrl(sheetId, prev.slug), label: "Back" } : undefined}
  next={next ? { href: referenceEntryUrl(sheetId, next.slug), label: "Next" } : undefined}
  placement={placement}
  ariaLabel="Reference navigation"
/>
