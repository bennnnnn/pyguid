---
import type { LessonGroup } from "../../lib/lessons";
import { getAllLessonsInGroup, getTotalLessonCount, lessonUrl } from "../../lib/lessons";

interface Props {
  groups: LessonGroup[];
}

const { groups } = Astro.props;
const lessonCount = getTotalLessonCount(groups);
const chapterCount = groups.length;
---

<section class="home-section" id="curriculum">
  <div class="home-container">
    <div class="home-section-head">
      <h2>{chapterCount} chapters · {lessonCount} tutorials</h2>
      <p>
        A structured path from your first <code>print()</code> to classes, comprehensions, testing,
        and clean code. Open the full tutorial outline to browse every lesson.
      </p>
    </div>

    <div class="home-curriculum-grid">
      {
        groups.map((group) => {
          const path = getAllLessonsInGroup(group);
          const first = path[0];
          const lessonCount = path.length;
          return (
            <article class="home-curriculum-summary">
              <h3 class="home-curriculum-heading">
                <span class="home-curriculum-title">{group.chapterTitle}</span>
                <span class="home-curriculum-count" aria-label={`${lessonCount} lessons`}>
                  {lessonCount}
                </span>
              </h3>
              {first && (
                <div class="home-curriculum-actions">
                  <a href={lessonUrl(first.id)} class="text-link text-sm font-semibold">
                    Start section
                  </a>
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <p class="home-curriculum-footer">
      <a href="/python/" class="btn-primary">Open tutorial outline</a>
    </p>
  </div>
</section>
