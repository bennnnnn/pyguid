---
import type { LessonGroup } from "../../lib/lessons";
import { getAllLessonsInGroup, lessonUrl } from "../../lib/lessons";

interface Props {
  groups: LessonGroup[];
  sectionCount: number;
  lessonCount: number;
}

const { groups, sectionCount, lessonCount } = Astro.props;
---

<section class="home-section" id="curriculum">
  <div class="home-container">
    <div class="home-section-head">
      <h2>Python curriculum · {sectionCount} topics · {lessonCount} lessons</h2>
      <p>
        The full Python tutorial path — from your first <code>print()</code> to classes, testing,
        and clean code. Other tracks (FastAPI, AI terms, quizzes, references) live in the sections
        above.
      </p>
    </div>

    <div class="home-curriculum-grid">
      {
        groups.map((group) => {
          const path = getAllLessonsInGroup(group);
          const first = path[0];
          const count = path.length;
          return (
            <article class="home-curriculum-summary">
              <h3 class="home-curriculum-heading">
                <span class="home-curriculum-title">{group.chapterTitle}</span>
                <span class="home-curriculum-count" aria-label={`${count} lessons`}>
                  {count}
                </span>
              </h3>
              {first && (
                <div class="home-curriculum-actions">
                  <a href={lessonUrl(first.id)} class="text-link text-sm font-semibold">
                    Start section
                  </a>
                </div>
              )}
            </article>
          );
        })
      }
    </div>

    <p class="home-curriculum-footer">
      <a href="/python/" class="btn-primary">Open Python tutorials</a>
    </p>
  </div>
</section>
