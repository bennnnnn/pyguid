---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div
  class="lesson-quick-answer not-prose mb-6 rounded-lg border-l-4 border-brand bg-surface-muted/50 px-4 py-3"
>
  <p class="!m-0 text-sm">
    <strong class="text-text">Quick answer:</strong>{" "}
    <span class="text-text-secondary">{text}</span>
  </p>
</div>
