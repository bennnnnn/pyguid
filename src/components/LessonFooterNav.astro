---
import type { LessonEntry } from "../lib/lessons";
import { lessonUrl } from "../lib/lessons";
import PagerNav from "./PagerNav.astro";

interface Props {
  prev: LessonEntry | null;
  next: LessonEntry | null;
  placement?: "top" | "bottom";
}

const { prev, next, placement = "bottom" } = Astro.props;
---

<PagerNav
  prev={prev ? { href: lessonUrl(prev.id), label: "Back" } : null}
  next={next ? { href: lessonUrl(next.id), label: "Next tutorial →" } : null}
  placement={placement}
  ariaLabel="Lesson navigation"
/>
