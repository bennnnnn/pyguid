---
import { AI_TERMINOLOGY_FAQ } from "../../lib/ai-terminology/faq";
---

<section class="ai-term-panel ai-term-faq" aria-labelledby="ai-term-faq-heading">
  <h2 id="ai-term-faq-heading">Common questions</h2>
  <dl class="ai-term-faq-list">
    {
      AI_TERMINOLOGY_FAQ.map((item) => (
        <div class="ai-term-faq-item">
          <dt>{item.question}</dt>
          <dd>{item.answer}</dd>
        </div>
      ))
    }
  </dl>
</section>
