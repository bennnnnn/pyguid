---
import { AI_TERM_STUDY_ORDER } from "../../lib/ai-terminology/study-order";
import { aiTerminologySectionUrl } from "../../lib/ai-terminology/helpers";
---

<section class="ai-term-panel" aria-labelledby="study-order-heading">
  <h2 id="study-order-heading">Study order</h2>
  <p class="ai-term-panel-intro">
    Work through these groups in order if you are new to AI vocabulary. Each link opens a
    full topic page in the sidebar.
  </p>
  <ol class="ai-term-study-order">
    {
      AI_TERM_STUDY_ORDER.map((item, index) => (
        <li>
          <span class="ai-term-study-order-num" aria-hidden="true">
            {index + 1}
          </span>
          <a href={aiTerminologySectionUrl(item.id)}>{item.title}</a>
        </li>
      ))
    }
  </ol>
</section>
