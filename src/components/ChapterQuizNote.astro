---
import { getQuizTopicForChapter, quizUrl } from "../lib/quiz-topics";

interface Props {
  chapter: number;
  chapterTitle: string;
}

const { chapter, chapterTitle } = Astro.props;
const topic = getQuizTopicForChapter(chapter);
---

{
  topic && (
    <aside class="chapter-quiz-note not-prose my-8 rounded-lg border border-border bg-surface-alt px-4 py-4">
      <p class="!m-0 text-sm leading-relaxed text-text-secondary">
        Finished this chapter? Try the{" "}
        <a href={quizUrl(topic.slug)} class="font-medium text-link">
          {topic.title} Quiz
        </a>
        . (TryIt boxes on this page are for quick practice — full chapter quiz is separate.)
      </p>
    </aside>
  )
}
