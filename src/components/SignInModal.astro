<div
  id="signin-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  aria-hidden="true"
  role="dialog"
  aria-labelledby="signin-title"
>
  <div class="absolute inset-0 bg-text/40 backdrop-blur-sm" data-close-signin></div>
  <div
    class="relative w-full max-w-md rounded-2xl border border-border bg-surface p-8 shadow-xl"
  >
    <button
      type="button"
      data-close-signin
      class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-lg text-text-muted hover:bg-surface-alt"
      aria-label="Close">✕</button
    >
    <h2 id="signin-title" class="text-xl font-bold text-text">Save your progress</h2>
    <p class="mt-2 text-sm leading-relaxed text-text-secondary">
      Optional sign-in with Google to track completed lessons. All content remains free.
    </p>
    <p
      class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900"
    >
      Sign-in is not available yet. You can use the full course without an account.
    </p>
    <button
      type="button"
      class="mt-6 w-full cursor-not-allowed rounded-lg bg-surface-alt px-4 py-3 text-sm font-medium text-text-muted"
      disabled
    >
      Continue with Google (coming soon)
    </button>
    <button
      type="button"
      data-close-signin
      class="mt-3 w-full rounded-lg py-2 text-sm font-medium text-brand hover:bg-brand-light"
    >
      Continue without signing in
    </button>
  </div>
</div>

<script>
  function initSignInModal() {
    const modal = document.getElementById("signin-modal");
    const openBtn = document.getElementById("open-signin");
    if (!modal || modal.dataset.bound === "true") return;
    modal.dataset.bound = "true";

    const openSignin = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
    };
    const closeSignin = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
    };

    openBtn?.addEventListener("click", openSignin);
    modal.querySelectorAll("[data-close-signin]").forEach((el) => {
      el.addEventListener("click", closeSignin);
    });
  }

  initSignInModal();
  document.addEventListener("astro:page-load", () => {
    const modal = document.getElementById("signin-modal");
    if (modal) delete modal.dataset.bound;
    initSignInModal();
  });
</script>
