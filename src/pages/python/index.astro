---
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import {
  getAllLessons,
  getAllLessonsInGroup,
  getLessonGroups,
  getTotalLessonCount,
  lessonUrl,
} from "../../lib/lessons";
import { SITE } from "../../lib/site";

const groups = await getLessonGroups();
const lessons = await getAllLessons();
const first = lessons[0];
const totalLessons = getTotalLessonCount(groups);
---

<TutorialLayout
  title={`Python Tutorials — ${SITE.name}`}
  description="Guided Python tutorials from beginner to advanced core Python, with runnable examples in your browser."
  groups={groups}
>
  <div class="mx-auto max-w-5xl">
    <header class="rounded-xl border border-border bg-surface-alt px-6 py-8 sm:px-8">
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-text-muted">
        Python tutorials
      </p>
      <h1 class="mt-2 mb-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        Python tutorials
      </h1>
      <p class="m-0 max-w-2xl text-base leading-relaxed text-text-secondary">
        {totalLessons} lessons from zero to advanced core Python. Every page has <strong
          >Run code</strong
        >
        in the browser. When you finish a chapter, take the matching quiz — references are always
        available for syntax lookup.
      </p>
      {
        first && (
          <a href={lessonUrl(first.id)} class="btn-primary mt-6">
            Start with {first.data.title}
          </a>
        )
      }
    </header>

    <div class="mt-10 space-y-8">
      {
        groups.map((group) => {
          const path = getAllLessonsInGroup(group);
          return (
            <section
              id={`chapter-${group.chapter}`}
              class="scroll-mt-20 rounded-xl border border-border bg-surface p-5 sm:p-6"
            >
              <h2 class="m-0 mb-4 text-lg font-semibold text-text">
                {group.chapterTitle}
              </h2>
              <ol class="m-0 list-decimal columns-1 gap-x-10 space-y-1.5 pl-5 text-sm sm:columns-2 [&>li]:break-inside-avoid">
                {path.map((lesson) => (
                  <li class="text-text-secondary">
                    <a href={lessonUrl(lesson.id)} class="font-medium text-link">
                      {lesson.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </div>
  </div>
</TutorialLayout>
