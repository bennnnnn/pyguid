---
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import {
  getAllLessons,
  getAllLessonsInGroup,
  getOutlineGroups,
  getTotalLessonCount,
  lessonUrl,
  topicAnchorId,
} from "../../lib/lessons";
import { SITE } from "../../lib/site";

const groups = await getOutlineGroups();
const lessons = await getAllLessons();
const first = lessons[0];
const totalLessons = getTotalLessonCount(groups);
const topicCount = groups.length;
---

<TutorialLayout
  title={`Python Tutorials — ${SITE.name}`}
  description="Guided Python tutorials from beginner to advanced core Python, with runnable examples in your browser."
  groups={groups}
>
  <div class="mx-auto max-w-5xl">
    <header class="tutorial-index-hero rounded-xl border px-6 py-8 sm:px-8">
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-text-muted">
        Tutorials → Quizzes → References
      </p>
      <h1 class="mt-2 mb-3 text-3xl font-bold tracking-tight text-text sm:text-4xl">
        Python tutorials
      </h1>
      <p class="m-0 max-w-2xl text-base leading-relaxed text-text-secondary">
        {totalLessons} lessons from your first print() through advanced Python — grouped by topic
        below. Every lesson has <strong>Run code</strong> in the browser. Finish a topic, take the
        quiz, and use references for quick syntax lookup.
      </p>

      <div class="tutorial-index-stats" aria-label="Course overview">
        <span class="tutorial-index-stat">{totalLessons} lessons</span>
        <span class="tutorial-index-stat">{topicCount} topics</span>
        <span class="tutorial-index-stat">Runnable examples</span>
      </div>

      {
        first && (
          <a href={lessonUrl(first.id)} class="btn-primary mt-6">
            Start with {first.data.title}
          </a>
        )
      }
    </header>

    <nav class="tutorial-outline mt-10 space-y-5" aria-label="Tutorial curriculum">
      {
        groups.map((group) => {
          const chapterLessons = getAllLessonsInGroup(group);
          const lessonCount = chapterLessons.length;
          const countLabel = lessonCount === 1 ? "1 lesson" : `${lessonCount} lessons`;

          return (
            <section
              id={topicAnchorId(group.chapterTitle)}
              class="tutorial-outline-card scroll-mt-20"
            >
              <div class="tutorial-outline-card-header">
                <div class="flex items-start justify-between gap-4">
                  <h2 class="m-0 text-lg font-semibold tracking-tight text-text">
                    {group.chapterTitle}
                  </h2>
                  <span class="tutorial-outline-badge">{countLabel}</span>
                </div>
              </div>

              <ol class="tutorial-lesson-grid">
                {chapterLessons.map((lesson, index) => (
                  <li class="m-0 min-w-0">
                    <a href={lessonUrl(lesson.id)} class="tutorial-lesson-link">
                      <span class="tutorial-lesson-num" aria-hidden="true">
                        {index + 1}
                      </span>
                      <span class="tutorial-lesson-title">
                        {lesson.data.navTitle ?? lesson.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </nav>
  </div>
</TutorialLayout>
