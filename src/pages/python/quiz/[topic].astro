---
import TutorialLayout from "../../../layouts/TutorialLayout.astro";
import ChapterQuiz from "../../../components/quiz/ChapterQuiz.astro";
import {
  getPublishedQuizTopics,
  getQuizExam,
  getQuizTopic,
  quizUrl,
} from "../../../lib/quiz-topics";
import {
  breadcrumbListJsonLd,
  quizLearningResourceJsonLd,
} from "../../../lib/seo-schema";
import { SITE, getSiteUrl } from "../../../lib/site";

export function getStaticPaths() {
  return getPublishedQuizTopics().map((topic) => ({
    params: { topic: topic.slug },
  }));
}

const topic = getQuizTopic(Astro.params.topic ?? "");
if (!topic) return Astro.redirect("/python/quiz/");

const exam = getQuizExam(topic);
if (!exam) return Astro.redirect("/python/quiz/");

const pageTitle = `${topic.title} Quiz — ${SITE.name}`;
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(quizUrl(topic.slug), `${siteUrl}/`).href;
const jsonLd = [
  breadcrumbListJsonLd([
    { name: SITE.name, url: `${siteUrl}/` },
    { name: "Quizzes", url: `${siteUrl}/python/quiz/` },
    { name: topic.title, url: pageUrl },
  ]),
  quizLearningResourceJsonLd({
    siteUrl,
    url: pageUrl,
    name: exam.title,
    description: exam.description,
    chapterTitle: topic.title,
  }),
];
---

<TutorialLayout
  title={pageTitle}
  description={exam.description}
  sidebar="quiz"
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="lesson-prose lesson-prose-wide">
    <ChapterQuiz
      exam={exam}
      quizSlug={topic.slug}
      kindLabel="Chapter quiz"
      backHref="/python/quiz/"
      backLabel="All quizzes"
    />
  </article>
</TutorialLayout>
