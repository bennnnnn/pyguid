---
import { render } from "astro:content";
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import LessonPager from "../../components/LessonPager.astro";
import PythonExample from "../../components/PythonExample.astro";
import Callout from "../../components/Callout.astro";
import OperatorTable from "../../components/OperatorTable.astro";
import TryIt from "../../components/TryIt.astro";
import {
  getAllLessons,
  getLessonGroups,
  getAdjacentLessons,
  getChapterLessons,
  lessonUrl,
} from "../../lib/lessons";
import { SITE, getSiteUrl } from "../../lib/site";
import LessonRelated from "../../components/LessonRelated.astro";
import QuickAnswer from "../../components/QuickAnswer.astro";
import SeoFaq from "../../components/SeoFaq.astro";
import PracticeExamsNote from "../../components/PracticeExamsNote.astro";

export async function getStaticPaths() {
  const lessons = await getAllLessons();
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
  }));
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/python/");

const groups = await getLessonGroups();
const lessons = await getAllLessons();
const lesson = lessons.find((l) => l.id === slug);
if (!lesson) return Astro.redirect("/python/");

const { Content } = await render(lesson);
const { prev, next } = getAdjacentLessons(lessons, slug);

const pageTitle = `${lesson.data.title} — ${SITE.name}`;
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(lessonUrl(slug), `${siteUrl}/`).href;
const chapterLessons = getChapterLessons(groups, lesson.data.chapter);

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: SITE.name,
      item: `${siteUrl}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Python",
      item: `${siteUrl}/python/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: lesson.data.chapterTitle,
      item: pageUrl,
    },
    {
      "@type": "ListItem",
      position: 4,
      name: lesson.data.title,
      item: pageUrl,
    },
  ],
};

const articleLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: lesson.data.title,
  description: lesson.data.description,
  url: pageUrl,
  learningResourceType: "Lesson",
  educationalLevel: lesson.data.level ?? "beginner",
  inLanguage: "en",
  isPartOf: {
    "@type": "Course",
    name: `PyGuide — ${lesson.data.chapterTitle}`,
    provider: {
      "@type": "Organization",
      name: SITE.name,
      url: siteUrl,
    },
  },
};

const faqs = lesson.data.faqs ?? [];
const jsonLd = [breadcrumbLd, articleLd];
if (faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  });
}
---

<TutorialLayout
  title={pageTitle}
  description={lesson.data.description}
  groups={groups}
  currentLessonId={slug}
  jsonLd={jsonLd}
>
  <article class="lesson-prose">
    <p class="!mt-0 text-sm text-text-muted">
      <a href="/" class="text-link no-underline hover:underline">{SITE.name}</a>
      <span class="mx-1.5">/</span>
      <a href="/python/" class="text-link no-underline hover:underline">Python</a>
      <span class="mx-1.5">/</span>
      <span>{lesson.data.chapterTitle}</span>
      {
        lesson.data.section && (
          <>
            <span class="mx-1.5">/</span>
            <span>{lesson.data.section}</span>
          </>
        )
      }
    </p>
    <h1>{lesson.data.title}</h1>
    {lesson.data.quickAnswer && <QuickAnswer text={lesson.data.quickAnswer} />}
    <Content components={{ PythonExample, Callout, OperatorTable, TryIt }} />
    <PracticeExamsNote
      chapter={lesson.data.chapter}
      chapterTitle={lesson.data.chapterTitle}
    />
    {faqs.length > 0 && <SeoFaq items={faqs} />}
    <LessonRelated current={lesson} chapterLessons={chapterLessons} />
    <LessonPager prev={prev} next={next} />
  </article>
</TutorialLayout>
