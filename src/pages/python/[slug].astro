---
import { render } from "astro:content";
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import LessonFooterNav from "../../components/LessonFooterNav.astro";
import LessonQuizCta from "../../components/LessonQuizCta.astro";
import PythonExample from "../../components/PythonExample.astro";
import Callout from "../../components/Callout.astro";
import OperatorTable from "../../components/OperatorTable.astro";
import QuickAnswer from "../../components/QuickAnswer.astro";
import LessonReferenceLink from "../../components/LessonReferenceLink.astro";
import RelatedLessons from "../../components/RelatedLessons.astro";
import {
  getAllLessons,
  getLessonGroups,
  getAdjacentLessons,
  getChapterLessons,
  lessonUrl,
} from "../../lib/lessons";
import { breadcrumbListJsonLd, pythonChapterUrl } from "../../lib/seo-schema";
import { SITE, getSiteUrl } from "../../lib/site";
export async function getStaticPaths() {
  const lessons = await getAllLessons();
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
  }));
}

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/python/");

const groups = await getLessonGroups();
const lessons = await getAllLessons();
const lesson = lessons.find((l) => l.id === slug);
if (!lesson) return Astro.redirect("/python/");

const { Content } = await render(lesson);
const { prev, next } = getAdjacentLessons(lessons, slug);
const chapterLessons = getChapterLessons(groups, lesson.data.chapter);

const pageTitle = `${lesson.data.title} — ${SITE.name}`;
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(lessonUrl(slug), `${siteUrl}/`).href;
const chapterUrl = pythonChapterUrl(siteUrl, lesson.data.chapter);
const breadcrumbLd = breadcrumbListJsonLd([
  { name: SITE.name, url: `${siteUrl}/` },
  { name: "Python", url: `${siteUrl}/python/` },
  { name: lesson.data.chapterTitle, url: chapterUrl },
  { name: lesson.data.title, url: pageUrl },
]);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: lesson.data.title,
  description: lesson.data.description,
  url: pageUrl,
  learningResourceType: "Lesson",
  educationalLevel: lesson.data.level ?? "beginner",
  inLanguage: "en",
  isPartOf: {
    "@type": "Course",
    name: `PyGuide — ${lesson.data.chapterTitle}`,
    provider: {
      "@type": "Organization",
      name: SITE.name,
      url: siteUrl,
    },
  },
};

const jsonLd = [breadcrumbLd, articleLd];
---

<TutorialLayout
  title={pageTitle}
  description={lesson.data.description}
  groups={groups}
  currentLessonId={slug}
  ogType="article"
  jsonLd={jsonLd}
>
  <article class="lesson-prose">
    <p class="!mt-0 text-sm text-text-muted">
      <a href="/" class="text-link">{SITE.name}</a>
      <span class="mx-1.5">/</span>
      <a href="/python/" class="text-link">Python</a>
      <span class="mx-1.5">/</span>
      <a href={`/python/#chapter-${lesson.data.chapter}`} class="text-link">
        {lesson.data.chapterTitle}
      </a>
      {
        lesson.data.section && (
          <>
            <span class="mx-1.5">/</span>
            <span>{lesson.data.section}</span>
          </>
        )
      }
    </p>
    <h1>{lesson.data.title}</h1>
    {lesson.data.quickAnswer && <QuickAnswer text={lesson.data.quickAnswer} />}
    <Content components={{ PythonExample, Callout, OperatorTable }} />
    <LessonReferenceLink chapter={lesson.data.chapter} />
    <LessonQuizCta chapter={lesson.data.chapter} />
    <RelatedLessons
      lessons={chapterLessons}
      currentLessonId={slug}
      chapterTitle={lesson.data.chapterTitle}
    />
    <LessonFooterNav prev={prev} next={next} />
  </article>
</TutorialLayout>
