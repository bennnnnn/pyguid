---
import TutorialLayout from "../../../layouts/TutorialLayout.astro";
import { getLessonGroups } from "../../../lib/lessons";
import { REFERENCE_SHEETS, referenceChapterUrl } from "../../../lib/reference-sheets";
import { SITE } from "../../../lib/site";
import "../../../styles/reference.css";

const groups = await getLessonGroups();
---

<TutorialLayout
  title={`Python Reference — ${SITE.name}`}
  description="Quick Python syntax reference by topic — lists, strings, functions, and more."
  groups={groups}
  sidebar="reference"
>
  <article class="lesson-prose-wide lesson-prose">
    <p class="!mt-0 text-sm text-text-muted">
      <a href="/" class="text-link">{SITE.name}</a>
      <span class="mx-1.5">/</span>
      <span>Reference</span>
    </p>

    <h1 class="!mt-2">Reference</h1>

    <ul class="ref-index-list not-prose">
      {
        REFERENCE_SHEETS.map((sheet) => (
          <li>
            <a href={referenceChapterUrl(sheet.id)} class="ref-index-link">
              {sheet.title}
            </a>
          </li>
        ))
      }
    </ul>
  </article>
</TutorialLayout>
