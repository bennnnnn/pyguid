---
import TutorialLayout from "../../../../layouts/TutorialLayout.astro";
import ReferenceEntryDetail from "../../../../components/reference/ReferenceEntryDetail.astro";
import { getLessonGroups } from "../../../../lib/lessons";
import {
  getAllReferenceEntryPages,
  getReferenceEntryPage,
} from "../../../../lib/reference-sheets";
import { getReferenceEntryCode } from "../../../../lib/reference-entry-code";
import { breadcrumbListJsonLd, techArticleJsonLd } from "../../../../lib/seo-schema";
import { SITE, getSiteUrl } from "../../../../lib/site";
import { referenceChapterUrl, referenceEntryUrl } from "../../../../lib/reference-sheets";
import "../../../../styles/reference.css";

export function getStaticPaths() {
  return getAllReferenceEntryPages().map(({ sheet, slug }) => ({
    params: { sheetId: sheet.id, entrySlug: slug },
  }));
}

const sheetId = Astro.params.sheetId ?? "";
const entrySlug = Astro.params.entrySlug ?? "";
const page = getReferenceEntryPage(sheetId, entrySlug);
if (!page) return Astro.redirect("/python/reference/");

const groups = await getLessonGroups();
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL(referenceEntryUrl(sheetId, entrySlug), `${siteUrl}/`).href;
const chapterRefUrl = new URL(referenceChapterUrl(sheetId), `${siteUrl}/`).href;
const { code } = getReferenceEntryCode(page);
const title = `${page.entry.title} — ${page.sheet.title} — ${SITE.name}`;
const description =
  page.entry.summary.length >= 120
    ? `${page.entry.summary} Runnable Python example on ${SITE.name}.`
    : `${page.entry.summary} Python ${page.sheet.title.toLowerCase()} syntax reference with a runnable example on ${SITE.name}.`;
const jsonLd = [
  breadcrumbListJsonLd([
    { name: SITE.name, url: `${siteUrl}/` },
    { name: "Reference", url: `${siteUrl}/python/reference/` },
    { name: page.sheet.title, url: chapterRefUrl },
    { name: page.entry.title, url: pageUrl },
  ]),
  techArticleJsonLd({
    siteUrl,
    url: pageUrl,
    headline: `${page.entry.title} — ${page.sheet.title}`,
    description: page.entry.summary,
    articleBody: code,
  }),
];
---

<TutorialLayout
  title={title}
  description={description}
  groups={groups}
  sidebar="reference"
  ogType="article"
  jsonLd={jsonLd}
>
  <div class="lesson-prose-wide">
    <ReferenceEntryDetail page={page} />
  </div>
</TutorialLayout>
