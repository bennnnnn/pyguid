---
import TutorialLayout from "../../../layouts/TutorialLayout.astro";
import { getLessonGroups } from "../../../lib/lessons";
import { getAllPracticeExams, practiceExamUrl } from "../../../lib/practice-exams";
import { SITE } from "../../../lib/site";

const groups = await getLessonGroups();
const exams = getAllPracticeExams();
const examByChapter = new Map(exams.map((e) => [e.chapter, e]));

const pageTitle = `Python practice exams by topic — ${SITE.name}`;
const description =
  "20-question practice exams for every PyGuide chapter. Answer all questions, submit, and see your score with explanations.";
---

<TutorialLayout title={pageTitle} description={description} groups={groups}>
  <article class="lesson-prose max-w-3xl">
    <h1>Practice exams</h1>
    <p class="text-lg text-text-muted">
      Each chapter has a <strong>20-question exam</strong>. Work through the lesson
      material first, then test yourself. You get a score, pass/fail, and a full review
      with explanations.
    </p>

    <ul class="not-prose mt-8 grid gap-4 sm:grid-cols-2">
      {
        groups.map((g) => {
          const exam = examByChapter.get(g.chapter);
          return (
            <li
              id={`chapter-${g.chapter}`}
              class="scroll-mt-20 rounded-xl border border-border bg-surface p-5 shadow-sm transition-shadow hover:border-brand/40 hover:shadow-md"
            >
              <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-brand">
                Chapter {g.chapter}
              </p>
              <h2 class="!mt-0 !mb-2 text-lg font-semibold text-text">
                {g.chapterTitle}
              </h2>
              {exam ? (
                <>
                  <p class="mb-4 text-sm text-text-muted">
                    {exam.questions.length} questions · Pass {exam.passPercent}%+
                  </p>
                  <a
                    href={practiceExamUrl(g.chapter)}
                    class="btn-primary inline-flex no-underline"
                  >
                    Start exam
                  </a>
                </>
              ) : (
                <p class="text-sm text-text-muted">Coming soon</p>
              )}
            </li>
          );
        })
      }
    </ul>

    <p class="mt-10">
      <a href="/python/what-is-python/" class="btn-secondary inline-block no-underline">
        Back to course
      </a>
    </p>
  </article>
</TutorialLayout>
