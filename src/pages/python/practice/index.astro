---
import TutorialLayout from "../../../layouts/TutorialLayout.astro";
import { getLessonGroups } from "../../../lib/lessons";
import { SITE } from "../../../lib/site";

const groups = await getLessonGroups();

const pageTitle = `Python practice — ${SITE.name}`;
const description =
  "Hands-on Python practice exercises. Chapter quizzes live under Quiz; this section is for coding drills and mini challenges.";
---

<TutorialLayout title={pageTitle} description={description} groups={groups}>
  <article class="lesson-prose max-w-3xl">
    <h1>Practice</h1>
    <p class="text-lg text-text-muted">
      <strong>Practice</strong> is for hands-on coding exercises — bigger than a TryIt box,
      smaller than a full project. Tutorials keep short “try it yourself” steps; practice
      drills will live here as we add them.
    </p>

    <div class="not-prose my-8 rounded-xl border border-border bg-surface-alt px-6 py-6">
      <h2 class="!mt-0 text-lg font-semibold text-text">Chapter quizzes</h2>
      <p class="mb-4 text-sm text-text-secondary">
        Multiple-choice chapter tests (20 questions, scored) are on the <strong>Quiz</strong>{" "}
        page — separate from lessons so tutorials stay clean.
      </p>
      <a href="/python/quiz/" class="btn-primary inline-flex no-underline">Go to quizzes</a>
    </div>

    <h2>Coming soon</h2>
    <p>
      Topic-based drills such as <code>/python/practice/variables/</code> and{" "}
      <code>/python/practice/lists/</code> — write code, not just answer multiple choice.
    </p>
  </article>
</TutorialLayout>
