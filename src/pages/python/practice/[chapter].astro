---
import { getQuizTopicForChapter, quizUrl } from "../../../lib/quiz-topics";
import { getAllPracticeExams } from "../../../lib/practice-exams";

/** Chapter-number practice URLs redirect to topic quizzes. */
export function getStaticPaths() {
  return getAllPracticeExams().map((exam) => ({
    params: { chapter: String(exam.chapter) },
  }));
}

const chapterNum = Number(Astro.params.chapter);
const topic = getQuizTopicForChapter(chapterNum);
if (topic) return Astro.redirect(quizUrl(topic.slug));
return Astro.redirect("/python/practice/");
---
