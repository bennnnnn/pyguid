---
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import Callout from "../../components/Callout.astro";
import { getLessonGroups, getTotalLessonCount, lessonUrl } from "../../lib/lessons";
import { SITE, getSiteUrl } from "../../lib/site";

const groups = await getLessonGroups();
const lessonCount = getTotalLessonCount(groups);
const siteUrl = getSiteUrl(Astro.site);

const levels = [
  {
    id: "L0",
    title: "Absolute beginner",
    summary: "Programming mindset, print, variables, input, first project.",
    slugs: [
      "what-is-python",
      "first-print",
      "creating-variables",
      "input-basics",
      "about-me-project",
    ],
  },
  {
    id: "L1",
    title: "Python foundations",
    summary: "Types, operators, strings, if/else, loops, collections.",
    slugs: [
      "data-types-overview",
      "arithmetic-operators",
      "strings",
      "if-indentation",
      "for-loops",
      "lists-intro",
      "dict-intro",
      "guessing-game-project",
      "todo-list-project",
    ],
  },
  {
    id: "L2",
    title: "Problem solving",
    summary: "Functions, scope, debugging, patterns, expense-style logic.",
    slugs: [
      "functions-intro",
      "function-return",
      "tracebacks",
      "loop-patterns",
      "list-comprehensions",
      "dict-comprehensions",
      "tip-calculator-project",
    ],
  },
  {
    id: "L3",
    title: "Real Python",
    summary: "Files, JSON, CSV, exceptions, modules, venv, logging.",
    slugs: [
      "pathlib-basics",
      "json-python",
      "csv-read-write",
      "try-except",
      "venv-and-requirements",
      "logging-basic",
      "notes-app-project",
    ],
  },
  {
    id: "L4",
    title: "Professional Python",
    summary: "Typing, pytest, Git, lint/format, project layout, code review habits.",
    slugs: [
      "type-hints-intro",
      "mypy-type-checking",
      "pytest-basics",
      "git-python-workflow",
      "code-quality-tools",
      "pyproject-packaging",
      "multi-file-cli-capstone",
    ],
  },
  {
    id: "L5",
    title: "Backend Python",
    summary: "HTTP, FastAPI, SQLite/SQLAlchemy, async, deployment concepts.",
    slugs: [
      "http-client-intro",
      "flask-quickstart",
      "fastapi-preview",
      "sqlite3-database-basics",
      "sqlalchemy-orm-preview",
      "async-await-intro",
      "flask-json-api-capstone",
      "database-todo-project",
    ],
  },
  {
    id: "L6",
    title: "L4 readiness",
    summary: "Profiling, refactoring practice, capstones, interview-style challenges.",
    slugs: [
      "cprofile-performance",
      "pdb-debugger",
      "exception-chaining",
      "decorators-preview",
      "personality-quiz-project",
      "regex-basics",
    ],
  },
];

const pageTitle = `Python learning roadmap — ${SITE.name}`;
const description =
  "Structured path from zero to job-ready Python: beginner syntax, professional tooling, backend APIs, projects, and L4 interview prep. 196+ lessons with runnable examples.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "PyGuide Python Developer Roadmap",
  description,
  provider: { "@type": "Organization", name: SITE.name, url: siteUrl },
  numberOfCredits: lessonCount,
  educationalLevel: "Beginner to advanced",
  inLanguage: "en",
  url: new URL("/python/roadmap/", `${siteUrl}/`).href,
};
---

<TutorialLayout
  title={pageTitle}
  description={description}
  groups={groups}
  jsonLd={jsonLd}
>
  <article class="lesson-prose max-w-3xl">
    <h1>Python learning roadmap</h1>
    <p class="text-lg text-text-muted">
      PyGuide is built for two modes: <strong>course path</strong> (start at chapter 1) and
      <strong>search landing</strong> (jump to one topic from Google). This roadmap shows how
      {lessonCount} lessons map from <strong>zero → job-ready (L4)</strong>.
    </p>

    <Callout variant="note">
      <strong>Honest status:</strong> Syntax, projects, testing, Git, APIs, and databases are
      strong. Interview drills, auth depth, and production deployment still need expansion —
      see gaps below.
    </Callout>

    {
      levels.map((level) => (
        <section class="mt-10">
          <h2>
            {level.id}: {level.title}
          </h2>
          <p>{level.summary}</p>
          <ul>
            {level.slugs.map((slug) => (
              <li>
                <a href={lessonUrl(slug)} class="text-link no-underline hover:underline">
                  {slug.replace(/-/g, " ")}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <h2>What to build next on PyGuide</h2>
    <ul>
      <li>Per-lesson FAQ blocks for long-tail SEO</li>
      <li>Quizzes and progress tracking</li>
      <li>Comparison pages (append vs extend, list vs tuple)</li>
      <li>Interview question cluster</li>
      <li>Auth, Postgres, and deploy walkthroughs</li>
    </ul>

    <p>
      <a href="/python/what-is-python/" class="btn-primary inline-block no-underline">
        Start the course
      </a>
    </p>
  </article>
</TutorialLayout>
