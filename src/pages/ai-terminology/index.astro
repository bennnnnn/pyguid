---
import AiTermGroupTitle from "../../components/ai-terminology/AiTermGroupTitle.astro";
import AiTermSearch from "../../components/ai-terminology/AiTermSearch.astro";
import TutorialLayout from "../../layouts/TutorialLayout.astro";
import {
  AI_TERMINOLOGY_META,
  getAiTerminologyStats,
  getPublishedAiTerminologySections,
} from "../../lib/ai-terminology";
import { aiTerminologySectionUrl } from "../../lib/ai-terminology/helpers";
import { breadcrumbListJsonLd, itemListJsonLd } from "../../lib/seo-schema";
import { SITE, getSiteUrl } from "../../lib/site";
import "../../styles/ai-terminology.css";

const { title, subtitle, description } = AI_TERMINOLOGY_META;
const sections = getPublishedAiTerminologySections();
const { sectionCount, termCount } = getAiTerminologyStats();
const firstSection = sections[0];
const pageTitle = `${title} — ${SITE.name}`;
const siteUrl = getSiteUrl(Astro.site);
const pageUrl = new URL("/ai-terminology/", `${siteUrl}/`).href;

const jsonLd = [
  breadcrumbListJsonLd([
    { name: SITE.name, url: `${siteUrl}/` },
    { name: title, url: pageUrl },
  ]),
  itemListJsonLd({
    pageUrl,
    name: title,
    items: sections.map((section) => ({
      name: section.title,
      url: new URL(aiTerminologySectionUrl(section.id), `${siteUrl}/`).href,
    })),
  }),
];
---

<TutorialLayout
  title={pageTitle}
  description={description}
  jsonLd={jsonLd}
  sidebar="ai-terms"
>
  <div class="mx-auto max-w-5xl lesson-prose-wide">
    <header class="tutorial-index-hero ai-term-hero rounded-xl border px-6 py-8 sm:px-8">
      <h1 class="ai-term-hero-title !mt-0">
        <span>{title}</span>
        <span class="ai-term-count ai-term-count-hero" title={`${termCount} terms`}>
          {termCount}
        </span>
      </h1>
      <p class="m-0 max-w-2xl text-base leading-relaxed text-text-secondary">
        {subtitle}
        <span class="ai-term-hero-meta">{termCount} terms · {sectionCount} topics</span>
      </p>

      {
        firstSection && (
          <a href={aiTerminologySectionUrl(firstSection.id)} class="btn-primary mt-6">
            Start with {firstSection.title}
          </a>
        )
      }
    </header>

    <div class="mt-8">
      <AiTermSearch />
    </div>

    <nav class="ai-term-index-grid mt-10" aria-label="AI terminology topics">
      <ul class="ai-term-group-cards">
        {
          sections.map((section) => (
            <li data-ai-term-section-card={section.id}>
              <a href={aiTerminologySectionUrl(section.id)} class="ai-term-group-card">
                <AiTermGroupTitle title={section.title} count={section.terms.length} />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="ai-term-search-empty" data-ai-term-search-empty hidden>
        No topics match your search. Try a different term or clear the search box.
      </p>
    </nav>
  </div>
</TutorialLayout>
