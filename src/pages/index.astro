---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeCurriculum from "../components/home/HomeCurriculum.astro";
import { getPublishedAiTerminologySections } from "../lib/ai-terminology/catalog";
import { getAllFastapiLessons } from "../lib/fastapi-lessons";
import { getLessonGroups, getTotalLessonCount } from "../lib/lessons";
import { getPublishedQuizTopics } from "../lib/quiz-topics";
import { getReferenceMenuItems } from "../lib/reference-sheets";
import { websiteJsonLd } from "../lib/seo-schema";
import { SITE, getSiteUrl } from "../lib/site";
import "../styles/home.css";

const groups = await getLessonGroups();
const lessonCount = getTotalLessonCount(groups);
const sectionCount = groups.length;
const firstLesson = groups[0]?.lessons[0];
const fastapiLessons = await getAllFastapiLessons();
const quizTopics = getPublishedQuizTopics();
const aiSections = getPublishedAiTerminologySections();
const referenceTopics = getReferenceMenuItems();
const siteUrl = getSiteUrl(Astro.site);

const tracks = [
  {
    href: "/python/",
    title: "Python",
    description: "Step-by-step tutorials from your first print() to advanced core Python.",
    stat: `${lessonCount} lessons`,
  },
  {
    href: "/fastapi/",
    title: "FastAPI",
    description: "Build APIs with FastAPI — routes, Pydantic, auth, testing, and deployment.",
    stat: `${fastapiLessons.length} lessons`,
  },
  {
    href: "/ai-terminology/",
    title: "AI Terms",
    description: "Plain-language glossary for LLMs, RAG, agents, MCP, and modern AI vocabulary.",
    stat: `${aiSections.length} topics`,
  },
  {
    href: "/python/reference/",
    title: "References",
    description: "Quick syntax lookup for strings, lists, loops, functions, and more.",
    stat: `${referenceTopics.length} sheets`,
  },
  {
    href: "/python/quiz/",
    title: "Quizzes",
    description: "Chapter quizzes to check what you remember after the tutorials.",
    stat: `${quizTopics.length} quizzes`,
  },
];
---

<SiteLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={websiteJsonLd(siteUrl)}
>
  <!-- Hero -->
  <section class="home-hero">
    <div class="home-container home-hero-inner">
      <div>
        <p class="home-eyebrow">Free · No install · Run code in the browser</p>
        <h1>Learn Python, FastAPI, and AI — all in one place.</h1>
        <p class="home-hero-lead">
          PyGuide brings together Python tutorials, a FastAPI roadmap, an AI terminology glossary,
          chapter quizzes, and quick references. Read a lesson, run the code, test yourself, and look
          up syntax when you need it.
        </p>
        <div class="home-hero-actions">
          <a href="/python/" class="btn-primary">Start Python</a>
          <a href="/fastapi/" class="btn-secondary">FastAPI track</a>
        </div>
        <ul class="home-hero-tracks" aria-label="All learning areas">
          {
            tracks.map((track) => (
              <li>
                <a href={track.href} class="home-hero-track-link">
                  {track.title}
                </a>
              </li>
            ))
          }
        </ul>
        <dl class="home-stats">
          <div class="home-stat">
            <strong>{lessonCount}</strong>
            <span>Python lessons</span>
          </div>
          <div class="home-stat">
            <strong>{fastapiLessons.length}</strong>
            <span>FastAPI lessons</span>
          </div>
          <div class="home-stat">
            <strong>{quizTopics.length}</strong>
            <span>quizzes</span>
          </div>
          <div class="home-stat">
            <strong>{aiSections.length}</strong>
            <span>AI term topics</span>
          </div>
        </dl>
      </div>

      <div class="home-code-panel" aria-hidden="true">
        <div class="home-code-titlebar">
          <span class="home-code-dot"></span>
          <span class="home-code-dot"></span>
          <span class="home-code-dot"></span>
          <span class="home-code-filename">hello.py</span>
        </div>
        <pre class="home-code-body"><code><span style="color:#c678dd">print</span>(<span style="color:#98c379">"Hello, PyGuide!"</span>)
<span style="color:#c678dd">print</span>(<span style="color:#d19a66">2</span> + <span style="color:#d19a66">2</span>)
name = <span style="color:#98c379">"Python"</span>
<span style="color:#c678dd">print</span>(<span style="color:#98c379">f"Welcome to </span><span style="color:#e5c07b">{</span>name<span style="color:#e5c07b">}</span><span style="color:#98c379">"</span>)</code></pre>
        <pre class="home-code-output">Hello, PyGuide!
4
Welcome to Python</pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>Built for how you actually learn</h2>
        <p>
          Five areas — Python, FastAPI, AI terms, quizzes, and references — so you always know
          where to go next.
        </p>
      </div>
      <ul class="home-features">
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">▶</div>
          <h3>Run code on every page</h3>
          <p>Press Run on Python examples. Output appears below — copy, edit, and experiment in seconds.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">1</div>
          <h3>One topic per lesson</h3>
          <p>Short pages focused on a single idea. Use Back and Next to move through each track in order.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">≡</div>
          <h3>Sidebar navigation</h3>
          <p>Jump between Python lessons, FastAPI topics, AI glossary sections, quizzes, and references.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">✓</div>
          <h3>Free to use</h3>
          <p>No paywall on content. Optional Google sign-in saves quiz progress — everything stays open.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>How it works</h2>
        <p>Pick a track, learn at your pace, then quiz yourself or look things up.</p>
      </div>
      <ol class="home-steps">
        <li class="home-step">
          <h3>Choose your track</h3>
          <p>
            Start with Python basics, follow the FastAPI roadmap, browse AI terminology, open a quiz,
            or jump to a reference sheet.
          </p>
        </li>
        <li class="home-step">
          <h3>Read and run</h3>
          <p>Each lesson explains one concept with examples. Run Python code in the browser as you go.</p>
        </li>
        <li class="home-step">
          <h3>Quiz and reference</h3>
          <p>Take a chapter quiz after Python topics. Use References and AI Terms when you need a fast reminder.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- All tracks -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>Everything on {SITE.name}</h2>
        <p>Python tutorials, FastAPI, AI glossary, quizzes, and references — each with its own sidebar.</p>
      </div>
      <div class="home-paths">
        {
          tracks.map((track) => (
            <a href={track.href} class="home-path-card">
              <div>
                <p class="home-path-stat">{track.stat}</p>
                <h3>{track.title}</h3>
                <p class="home-path-desc">{track.description}</p>
              </div>
              <span class="home-path-link">Open {track.title} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Python curriculum (dynamic) -->
  <HomeCurriculum groups={groups} sectionCount={sectionCount} lessonCount={lessonCount} />

  <!-- Final CTA -->
  <section class="home-cta">
    <div class="home-container home-cta-inner">
      <h2>Ready to start learning?</h2>
      <p>
        Pick any track below — Python, FastAPI, AI terms, quizzes, or references — and dive in at
        your own pace.
      </p>
      <div class="home-cta-actions">
        {
          firstLesson ? (
            <a href={`/python/${firstLesson.id}/`} class="btn-primary">
              Start Python · {firstLesson.data.title}
            </a>
          ) : (
            <a href="/python/" class="btn-primary">Start Python</a>
          )
        }
        <a href="/fastapi/" class="btn-secondary">FastAPI track</a>
        <a href="/ai-terminology/" class="btn-secondary">AI terminology</a>
        <a href="/python/quiz/" class="btn-secondary">Quizzes</a>
        <a href="/python/reference/" class="btn-secondary">References</a>
      </div>
    </div>
  </section>
</SiteLayout>
