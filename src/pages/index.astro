---
import SiteLayout from "../layouts/SiteLayout.astro";
import HomeCurriculum from "../components/home/HomeCurriculum.astro";
import { getLessonGroups, getTotalLessonCount } from "../lib/lessons";
import { websiteJsonLd } from "../lib/seo-schema";
import { SITE, getSiteUrl } from "../lib/site";
import "../styles/home.css";

const groups = await getLessonGroups();
const lessonCount = getTotalLessonCount(groups);
const sectionCount = groups.length;
const firstLesson = groups[0]?.lessons[0];
const siteUrl = getSiteUrl(Astro.site);
---

<SiteLayout
  title={SITE.title}
  description={SITE.description}
  jsonLd={websiteJsonLd(siteUrl)}
>
  <!-- Hero -->
  <section class="home-hero">
    <div class="home-container home-hero-inner">
      <div>
        <p class="home-eyebrow">Free · No install · Run code in the browser</p>
        <h1>Learn Python from zero to advanced core Python.</h1>
        <p class="home-hero-lead">
          PyGuide is a free Python-only learning website with beginner-friendly tutorials, separate
          quizzes, and quick reference pages. Read the lesson, run the code, test yourself with
          quizzes, and use references when you need a fast reminder.
        </p>
        <div class="home-hero-actions">
          <a href="/python/what-is-python/" class="btn-primary">Start tutorials</a>
          <a href="/python/quiz/" class="btn-secondary">Browse quizzes</a>
        </div>
        <dl class="home-stats">
          <div class="home-stat">
            <strong>{lessonCount}</strong>
            <span>step-by-step lessons</span>
          </div>
          <div class="home-stat">
            <strong>{sectionCount}</strong>
            <span>topics</span>
          </div>
        </dl>
      </div>

      <div class="home-code-panel" aria-hidden="true">
        <div class="home-code-titlebar">
          <span class="home-code-dot"></span>
          <span class="home-code-dot"></span>
          <span class="home-code-dot"></span>
          <span class="home-code-filename">hello.py</span>
        </div>
        <pre class="home-code-body"><code><span style="color:#c678dd">print</span>(<span style="color:#98c379">"Hello, PyGuide!"</span>)
<span style="color:#c678dd">print</span>(<span style="color:#d19a66">2</span> + <span style="color:#d19a66">2</span>)
name = <span style="color:#98c379">"Python"</span>
<span style="color:#c678dd">print</span>(<span style="color:#98c379">f"Welcome to </span><span style="color:#e5c07b">{</span>name<span style="color:#e5c07b">}</span><span style="color:#98c379">"</span>)</code></pre>
        <pre class="home-code-output">Hello, PyGuide!
4
Welcome to Python</pre>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>Built for how you actually learn</h2>
        <p>Three clear sections — tutorials, quizzes, and references — so you always know where to go.</p>
      </div>
      <ul class="home-features">
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">▶</div>
          <h3>Run code on every page</h3>
          <p>Press Run on any example. Output appears below — copy, edit, and experiment in seconds.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">1</div>
          <h3>One topic per lesson</h3>
          <p>Short pages focused on a single idea. Use Back and Next to move through the course in order.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">≡</div>
          <h3>Sidebar navigation</h3>
          <p>Jump to lists, loops, functions, classes, and more. Tutorials, quizzes, and references stay separate.</p>
        </li>
        <li class="home-feature">
          <div class="home-feature-icon" aria-hidden="true">✓</div>
          <h3>Free to use</h3>
          <p>No paywall on lessons. Optional sign-in later to save progress — the course stays open.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>How it works</h2>
        <p>Three steps from zero to writing your own programs.</p>
      </div>
      <ol class="home-steps">
        <li class="home-step">
          <h3>Pick a lesson</h3>
          <p>Start at What is Python? or open any topic in the sidebar — Getting Started, Variables, Loops, and beyond.</p>
        </li>
        <li class="home-step">
          <h3>Read and run</h3>
          <p>Each page explains one concept with examples. Run them in the browser to see Python in action.</p>
        </li>
        <li class="home-step">
          <h3>Quiz and reference</h3>
          <p>Take a chapter quiz when you finish a topic. Use References for quick syntax lookup while you code.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Tutorials · Quizzes · References -->
  <section class="home-section">
    <div class="home-container">
      <div class="home-section-head">
        <h2>Three ways to use {SITE.name}</h2>
        <p>Tutorials teach slowly. Quizzes test separately. References help you look things up fast.</p>
      </div>
      <div class="home-paths">
        <a href="/python/" class="home-path-card">
          <h3>Python Tutorials</h3>
          <p>
            Full guided lessons from beginner to advanced core Python — explanations and runnable examples,
            and one idea per page.
          </p>
          <span class="home-path-link">Open tutorials →</span>
        </a>
        <a href="/python/quiz/" class="home-path-card">
          <h3>Python Quizzes</h3>
          <p>
            Chapter quizzes by topic so you can check understanding without cluttering lesson pages.
          </p>
          <span class="home-path-link">Open quizzes →</span>
        </a>
        <a href="/python/reference/" class="home-path-card">
          <h3>Python References</h3>
          <p>
            Fast lookup for syntax, methods, and common mistakes — strings, lists, dicts, loops, functions,
            and classes.
          </p>
          <span class="home-path-link">Open references →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Full curriculum (dynamic) -->
  <HomeCurriculum groups={groups} />

  <!-- Final CTA -->
  <section class="home-cta">
    <div class="home-container">
      <h2>Ready to write Python?</h2>
      <p>
        Start with <code style="background:rgba(255,255,255,0.15);padding:0.15rem 0.4rem;border-radius:0.25rem;border:none">print()</code>
        and work through lists, loops, functions, files, and classes at your own pace.
      </p>
      <div class="home-cta-actions">
        {
          firstLesson ? (
            <a href={`/python/${firstLesson.id}/`} class="btn-primary">
              Start with {firstLesson.data.title}
            </a>
          ) : (
            <a href="/python/" class="btn-primary">Start the course</a>
          )
        }
        <a href="/python/reference/" class="btn-secondary">Open references</a>
      </div>
    </div>
  </section>
</SiteLayout>
