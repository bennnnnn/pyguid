---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChapterCard from "../../components/ChapterCard.astro";
import { getAllChapters } from "../../lib/chapters";

const chapters = await getAllChapters();
---

<BaseLayout title="Learn Python — PyGuide" description="Python tutorial chapters with sub-topics and runnable examples.">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-3xl font-bold text-ink-900">Learn Python</h1>
    <p class="mt-2 text-ink-600">All chapters in order. Each card shows every sub-topic inside.</p>
    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      {chapters.map((chapter) => (
        <ChapterCard chapter={chapter} />
      ))}
    </div>
  </div>
</BaseLayout>
